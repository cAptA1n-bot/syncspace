{
  "name": "syncspace-backend",
  "version": "1.0.0",
  "description": "SyncSpace backend — Express, MongoDB, Socket.IO",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
