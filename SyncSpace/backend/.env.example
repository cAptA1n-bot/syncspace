# ─── SyncSpace Backend Environment Configuration ──────────────────────────────
# In production, set NODE_ENV=production, supply a long random JWT_SECRET,
# point MONGODB_URI to your production cluster, and set CLIENT_URL to your frontend domain(s).

# Server Port (default: 3000, cloud providers automatically set PORT)
PORT=3000

# Environment mode: development | production | test
NODE_ENV=production

# MongoDB connection string (local or MongoDB Atlas)
# Example Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/syncspace?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/syncspace

# Secret key for signing JWT auth tokens (generate a 64+ char random string)
# Command to generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# Allowed frontend origin(s) for CORS and Socket.IO.
# Support comma-separated URLs for multi-environment or preview branches.
# Example: CLIENT_URL=https://syncspace.vercel.app,https://syncspace-preview.vercel.app
CLIENT_URL=http://localhost:5173

# Cookie security settings:
# For production over HTTPS across separate domains (e.g. Vercel frontend + Render backend):
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
# For local development over HTTP:
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ─── Optional: AI Document Summarization (Google Gemini) ─────────────────────
# Required for the "Summarize with AI" feature
AI_PROVIDER=gemini
AI_API_KEY=your_google_gemini_api_key_here

# ─── Optional: Object Storage (S3-compatible) ─────────────────────────────────
# For persistent document file attachment binaries
# STORAGE_ENDPOINT=https://s3.amazonaws.com
# STORAGE_BUCKET=syncspace-attachments
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=us-east-1

# ─── Optional: Redis (for Socket.IO horizontal scaling across multiple servers)
# REDIS_URL=redis://localhost:6379

# ─── File Upload Limits ───────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain
