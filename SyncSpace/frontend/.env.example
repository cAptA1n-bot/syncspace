# ─── SyncSpace Frontend Environment Configuration ─────────────────────────────
# In production, set these to your backend server's public URL.
# If frontend & backend share a domain (via reverse proxy / Docker), use root `/` or relative paths.

# Public Backend API base URL
# Example Production: NEXT_PUBLIC_API_BASE_URL=https://syncspace-backend.onrender.com
# Example Local Dev:   NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Public Socket.IO server URL for real-time collaboration
# Example Production: NEXT_PUBLIC_SOCKET_URL=https://syncspace-backend.onrender.com
# Example Local Dev:   NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
